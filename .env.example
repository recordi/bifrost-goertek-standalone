BIFROST_ENV=dev
DAEMON_PORT=8787
RUNNER_PORT=8788
RUNNER_URL=http://127.0.0.1:8788
RUNNER_TIMEOUT_MS=30000
BIFROST_HMAC_SECRET=<random-secret-here>
# 记忆/治理路由的受信身份。只在 BIFROST_ENV=dev 下生效，staging/prod 配了会启动即失败：
# 一个固定操作员身份不是认证，生产必须接入真实认证中间件（security/feishu-auth.ts 尚是 @stub）。
# 不配则记忆/治理路由一律 401。项目必须显式列出（逗号分隔），不支持通配。
BIFROST_LOCAL_ACTOR_ID=user:local
BIFROST_LOCAL_ACTOR_PROJECTS=demo_goertek_m6
BIFROST_LOCAL_ACTOR_CAN_PROMOTE_ORG=false
# LLM 接入（OpenAI 兼容）。变量名必须与 agents/*.ts 实读一致：
# agents/governance.ts 校验 MODEL_API_BASE_URL 与 MODEL_API_KEY 同时存在，缺一即拒。
MODEL_API_BASE_URL=<openai-compatible-base-url>
MODEL_API_KEY=<your-api-key>
MODEL_NAME=grok-chat-fast
# 单次模型调用超时（毫秒，正整数）。留空则用默认 120000；配了非法值会启动即抛，
# 不会静默退回默认——见 agents/model-client.ts。SDK 自身默认是 600000，不是这个值。
MODEL_TIMEOUT=120000
DEFAULT_RUNTIME=claude-cli
FEISHU_APP_ID=<feishu-app-id>
FEISHU_APP_SECRET=<feishu-app-secret>
