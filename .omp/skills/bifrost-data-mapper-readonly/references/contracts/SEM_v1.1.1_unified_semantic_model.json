      "label_cn": "模拟版本",
      "type": "string"
    },
    "performance_rate_raw": {
      "label_cn": "性能率原始值（不截断）",
      "type": "ratio_float",
      "unit": "ratio",
      "rule": "保留原值；>1.0 不截断，由 validation_status 标记",
      "allow_above_unity": true
    },
    "performance_rate_validation_status": {
      "label_cn": "性能率校验状态",
      "type": "enum",
      "values": [
        "normal",
        "flagged_above_unity"
      ],
      "governed_by": "PERF-RATE-RULE-v1.0"
    },
    "performance_rate_calculation_rule": {
      "label_cn": "性能率计算规则",
      "type": "string",
      "ref": "PERF-RATE-RULE-v1.0"
    },
    "rule_version": {
      "label_cn": "性能率封顶治理版本",
      "type": "string",
      "ref": "PERF-RATE-RULE-v1.0",
      "note": "是否封顶必须由规则版本决定，映射程序不得自行决定"
    },
    "oee_source": {
      "label_cn": "OEE原值",
      "type": "ratio_0_1",
      "unit": "ratio",
      "note": "数据源原值，不得被复算值覆盖"
    },
    "oee_recomputed": {
      "label_cn": "OEE复算值",
      "type": "ratio_0_1",
      "unit": "ratio",
      "calculation": "oee_recomputed = availability × performance_rate_raw × quality_factor_raw",
      "note": "质量因子来源字段未被证明即OEE质量因子，can_recompute_oee=false，当前不得生成复算值"
    },
    "calculation_rule_version": "OEE-CALC-RULE-v1.1",
    "simulated_shift_id": {
      "label_cn": "模拟班次ID",
      "type": "string",
      "note": "不得与 source_shift_id 合并覆盖"
    },
    "related_shift_id": {
      "label_cn": "关联班次ID",
      "type": "string",
      "note": "不得与 source_shift_id/simulated_shift_id 合并覆盖"
    },
    "availability_raw": {
      "label_cn": "开动率原始值",
      "type": "ratio_0_1",
      "unit": "ratio",
      "note": "OEE复算公式中的 availability_raw 对应现有 shift.availability（来源开动率）"
    },
    "quality_factor_raw": {
      "label_cn": "OEE质量因子原始值",
      "type": "ratio_float",
      "unit": "ratio",
      "note": "来源字段未被证明即OEE质量因子；当前无可用值"
    },
    "quality_factor_source_field": {
      "label_cn": "OEE质量因子来源字段",
      "type": "string",
      "value": null,
      "candidates": [
        "01_OEE班次.质量率",
        "12_多产线班次_模拟.质量率"
      ],
      "note": "源质量率≠OEE质量因子未被排除亦未被证明，需人工确认"
    },
    "quality_factor_mapping_status": "ambiguous",
    "can_recompute_oee": false
  },
